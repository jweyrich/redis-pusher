{
	"name": "redis-pusher",
	"version": "0.3.0",
	"description": "A Node.js library (and CLI) that consumes messages published on Redis channels and sends them as Push Notifications via APNS (HTTP/2) or Firebase Cloud Messaging (HTTP v1).",
	"keywords": [
		"redis",
		"sharding",
		"apple",
		"push",
		"notification",
		"iOS",
		"apns",
		"android",
		"fcm",
		"firebase"
	],
	"author": "Jardel Weyrich <jweyrich@gmail.com>",
	"main": "index.js",
	"bin": {
		"redis-pusher": "bin/redis-pusher.js"
	},
	"files": [
		"index.js",
		"lib/",
		"bin/",
		"schemas/",
		"examples/"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jweyrich/redis-pusher.git"
	},
	"scripts": {
		"test": "node --test test/*.test.js"
	},
	"engines": {
		"node": ">=22"
	},
	"license": "MIT",
	"homepage": "https://github.com/jweyrich/redis-pusher#readme",
	"bugs": {
		"url": "https://github.com/jweyrich/redis-pusher/issues"
	},
	"dependencies": {
		"@redis/client": "^6.3.1"
	},
	"devDependencies": {
		"ajv": "^8.20.0"
	}
}
