{
	"name": "redis-pusher",
	"version": "0.3.0",
	"description": "A Node.js library (and CLI) that consumes messages published on Redis channels and sends them as Push Notifications via APNS (HTTP/2) or Firebase Cloud Messaging (HTTP v1).",
	"keywords": [
		"redis",
		"sharding",
		"apple",
		"push",
		"notification",
		"iOS",
		"apns",
		"android",
		"fcm",
		"firebase"
	],
	"author": "Jardel Weyrich <jweyrich@gmail.com>",
	"main": "index.js",
	"bin": {
		"redis-pusher": "bin/redis-pusher.js"
	},
	"files": [
		"index.js",
		"lib/",
		"bin/",
		"examples/"
	],
	"repository": {
		"type": "git",
		"url": "git@github.com:jweyrich/redis-pusher.git"
	},
	"scripts": {
		"test": "node --test test/*.test.js"
	},
	"dependencies": {
		"redis": "~0.8.4",
		"redis-locking-worker": "github:yahoo/redis-locking-worker#fd3300221acf1d78fd82afe8bd936a35d19f9084"
	},
	"engines": {
		"node": ">=22"
	},
	"license": "MIT"
}
